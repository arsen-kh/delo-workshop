[Unit]
Description=Delo Workshop CRM
After=network.target

[Service]
Type=simple
User=workshop
Group=workshop
WorkingDirectory=/opt/workshop
EnvironmentFile=/etc/workshop.env
ExecStart=/usr/bin/node server-dist/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/workshop
UMask=0077

[Install]
WantedBy=multi-user.target
